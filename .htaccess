Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
# block config, docs, sources, dumps, logs and dotfiles
<FilesMatch "(^config(\.sample)?\.php$|\.(md|sql|gz|log|lock|json|sh|ya?ml)$|^\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
